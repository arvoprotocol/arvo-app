generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  upcoming
  active
  auction
  completed
}

enum PublishStatus {
  draft
  published
}

model Project {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  location    String
  titleNumber String
  projectOrigin String @default("arvo")
  status      ProjectStatus
  statusLabel String
  stage       String
  acres       String
  plots       Int
  plotsSold   Int           @default(0)

  currency         String   @default("GBP")
  acquisitionPrice Decimal?
  guideValue       Decimal?
  soldValue        Decimal?

  acquisitionDate DateTime?
  displayJson String?
  trackPlots Boolean @default(false)
  plotDetails ProjectPlot[]

  auctionDate DateTime?
  description String

  image String?

  publishStatus PublishStatus @default(draft)
  sortOrder     Int           @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishStatus, status])
  @@index([sortOrder])
}

model PlatformSignup {
  id         Int       @id @default(autoincrement())
  type       String
  contact    String
  normalized String
  source     String    @default("platform")
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([type, normalized])
  @@index([createdAt])
}

model InvitationCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  label       String?
  isActive    Boolean   @default(true)
  maxUses     Int       @default(1)
  useCount    Int       @default(0)
  claimedBy   String?
  claimedType String?
  claimedAt   DateTime?
  accessAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([isActive])
  @@index([createdAt])
}

enum PartnerWalletType {
  metamask
  self_custody
  exchange
  unsure
}

enum PartnerStatus {
  awaiting
  confirmed
  change_requested
  needs_help
}

model StrategicPartner {
  id Int @id @default(autoincrement())

  name  String
  email String @unique

  originalWallet   String?
  registeredWallet String?
  walletType       PartnerWalletType?

  status PartnerStatus @default(awaiting)

  registrationToken String @unique

  robinhoodConfirmed Boolean @default(false)

  walletChangeReason String?
  notes              String?

  registrationSentAt DateTime?
  registeredAt       DateTime?
  confirmedAt        DateTime?
  changeRequestedAt  DateTime?
  changeApprovedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AdminBroadcastEmail {
  id             Int      @id @default(autoincrement())
  subject        String
  body           String
  recipientCount Int      @default(0)
  recipientsJson String
  isTest         Boolean  @default(false)
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([sentAt])
}

model ProjectPlot {
  id Int @id @default(autoincrement())
  projectId Int
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label String
  status String @default("available")
  salePrice Decimal?
  completionDate DateTime?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId, label])
  @@index([projectId, sortOrder])
}

model StakingVaultDraft {
  id Int @id @default(autoincrement())
  title String
  poolType String
  standardKind String
  valuesJson String
  productsJson String
  visibility String @default("hidden")
  sortOrder Int @default(0)
  seedKey String? @unique
  revision Int @default(1)
  linkedChainId Int?
  linkedProxy String?
  linkedPoolId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([visibility, sortOrder])
  @@unique([linkedChainId, linkedProxy, linkedPoolId])
}

model SupportTicket {
  id String @id
  accessHash String @unique
  ownerWallet String?
  lastAdminMessageId Int @default(0)
  lastReadAdminMessageId Int @default(0)
  name String
  email String?
  wallet String?
  category String
  subject String
  status String @default("open")
  revision Int @default(1)
  messages SupportMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
  @@index([ownerWallet, updatedAt])
}
model SupportMessage {
  id Int @id @default(autoincrement())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author String
  adminAddress String?
  body String
  createdAt DateTime @default(now())
  @@index([ticketId, id])
}
model SupportNotification {
  id String @id
  ticketId String
  messageId Int @unique
  kind String
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  lockToken String?
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([sentAt, nextAttemptAt])
}

model SupportRateLimit {
  key String @id
  count Int @default(0)
  windowStart DateTime
  @@index([windowStart])
}

model WalletChallenge {
  id String @id
  address String
  chainId Int
  message String
  expiresAt DateTime
  @@index([expiresAt])
}
model WalletSession {
  id String @id
  address String
  chainId Int
  expiresAt DateTime
  @@index([expiresAt])
}
