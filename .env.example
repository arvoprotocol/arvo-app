# Example only. Never commit .env.local or actual credentials.
DATABASE_URL=file:./prisma/arvo-development.db
NEXT_PUBLIC_SITE_URL=https://arvoprotocol.com
NEXT_PUBLIC_APP_URL=https://app.arvoprotocol.com
# Configure the intended network and deployment; no mainnet defaults are supplied.
NEXT_PUBLIC_STAKING_CHAIN_ID=
NEXT_PUBLIC_STAKING_RPC_URL=
NEXT_PUBLIC_STAKING_PROXY_ADDRESS=
# Shared bonus contracts, one per vault, comma-separated (empty until deployed and funded).
NEXT_PUBLIC_BONUS_ADDRESSES=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ADMIN_WALLET_ADDRESS=
ADMIN_SESSION_SECRET=
APP_ACCESS_SESSION_SECRET=
APP_ACCESS_PASSWORD=
# Set to 1 at public release to remove the early-access password gate.
APP_PUBLIC_ACCESS=
# Use an absolute directory outside the repository for uploaded project media.
PROJECT_UPLOAD_DIR=
# Independent key (32+ chars) for signed waitlist unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Arvo
MAIL_TEAM_ADDRESS=
# Optional community feed credentials
X_API_BEARER_TOKEN=
# Arvo Intelligence beta (server-side only; never NEXT_PUBLIC_). Set a monthly
# spend limit for this key in the Anthropic console.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (Console → Settings → Workspaces → the workspace ID, wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
INTELLIGENCE_MODEL=claude-sonnet-5-5
# Questions per visitor per day (global cap is 20x this, minimum 300).
INTELLIGENCE_DAILY_LIMIT=10
# Transparency page (public addresses, shown and verified onchain).
NEXT_PUBLIC_TIMELOCK_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_SAFE_ADDRESS=
NEXT_PUBLIC_PAUSER_ADDRESS=
NEXT_PUBLIC_TREASURY_SAFE_ADDRESS=
NEXT_PUBLIC_REWARDS_WALLET_ADDRESS=
# Optional: block restricted countries using the CDN country header (e.g. Cloudflare).
GEO_BLOCK=
# First Edition vault id, for founding staker status and admin export.
NEXT_PUBLIC_FOUNDING_POOL_ID=
# Maturity reminders: shared secret for the hourly cron call (32+ chars).
CRON_SECRET=
# Optional: block range per log query when indexing vault activity.
STAKING_LOG_CHUNK=50000
# Legacy single bonus address (prefer NEXT_PUBLIC_BONUS_ADDRESSES).
NEXT_PUBLIC_FIRST_EDITION_BONUS_ADDRESS=
# Admin → Governance role check: "Governance Safe=0x…,Timelock=0x…,Emergency wallet=0x…" (public addresses only).
NEXT_PUBLIC_GOVERNANCE_ADDRESSES=
# Optional override for the Buy ARVO swap link (defaults to Uniswap on Robinhood Chain).
NEXT_PUBLIC_BUY_ARVO_URL=
# Optional inboxes for the Projects and Private Partnerships forms (default: MAIL_TEAM_ADDRESS, then team@arvoprotocol.com).
PROJECT_SUBMISSIONS_TO=
PARTNERSHIP_ENQUIRIES_TO=
# Strategic Partner releases: TGE date override (YYYY-MM-DD). Leave empty to use 2026-09-25.
ARVO_TGE_DATE=

# Server-only RPC for reading staking events (recent activity, staker counts).
# Alchemy rejects eth_getLogs on Robinhood Chain, so use the public RPC here.
STAKING_LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
