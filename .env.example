# Example only. Never commit .env.local or actual credentials.
DATABASE_URL=file:./prisma/arvo-development.db
NEXT_PUBLIC_SITE_URL=https://arvoprotocol.com
NEXT_PUBLIC_APP_URL=https://app.arvoprotocol.com
# Configure the intended network and deployment; no mainnet defaults are supplied.
NEXT_PUBLIC_STAKING_CHAIN_ID=
NEXT_PUBLIC_STAKING_RPC_URL=
NEXT_PUBLIC_STAKING_PROXY_ADDRESS=
# Shared bonus contracts, one per vault, comma-separated (empty until deployed and funded).
NEXT_PUBLIC_BONUS_ADDRESSES=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ADMIN_WALLET_ADDRESS=
ADMIN_SESSION_SECRET=
APP_ACCESS_SESSION_SECRET=
APP_ACCESS_PASSWORD=
# Set to 1 at public release to remove the early-access password gate.
APP_PUBLIC_ACCESS=
# Use an absolute directory outside the repository for uploaded project media.
PROJECT_UPLOAD_DIR=
# Independent key (32+ chars) for signed waitlist unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Arvo
MAIL_TEAM_ADDRESS=
# Optional community feed credentials
X_API_BEARER_TOKEN=
# Arvo Intelligence beta (server-side only; never NEXT_PUBLIC_). Set a monthly
# spend limit for this key in the Anthropic console.
ANTHROPIC_API_KEY=
INTELLIGENCE_MODEL=claude-sonnet-5-5
# Questions per visitor per day (global cap is 20x this, minimum 300).
INTELLIGENCE_DAILY_LIMIT=10
